{{ 'paginas-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Colunas: abertura (selo, título, texto) e grade de colunas, cada uma com ícone ou imagem,
  título, texto e link opcional.
  Arranjos: card (cartão com borda), plain (sem cartão) e inline (ícone ao lado do texto,
  como a faixa de vantagens da maquete).
  Imagem de fundo opcional (snippets/section-background.liquid): com imagem, a seção usa o
  esquema "ink" e um véu azul-marinho sobre a foto; vazia, nada muda.
  Coluna sem título e sem texto não aparece. Sem colunas visíveis, a seção não renderiza nada.
{%- endcomment -%}

{%- liquid
  assign mc_visible_count = 0
  for block in section.blocks
    if block.settings.title != blank or block.settings.text != blank
      assign mc_visible_count = mc_visible_count | plus: 1
    endif
  endfor

  assign mc_scheme = section.settings.color_scheme
  assign mc_bg = section.settings.background_image
  if mc_bg != blank
    assign mc_scheme = 'ink'
  endif

  assign mc_columns = section.settings.columns_desktop
  assign mc_columns_tablet = 2
  if mc_columns == 3
    assign mc_columns_tablet = 3
  endif
  if mc_columns < 2
    assign mc_columns_tablet = 1
  endif

  assign mc_has_intro = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign mc_has_intro = true
  endif

  assign mc_item_tag = 'h2'
  if section.settings.heading != blank
    assign mc_item_tag = 'h3'
  endif

  assign mc_loading = 'lazy'
  unless section.index > 2
    assign mc_loading = 'eager'
  endunless

  assign mc_sizes = '(min-width: 1440px) calc(1280px / ' | append: mc_columns | append: '), (min-width: 990px) calc((100vw - 160px) / ' | append: mc_columns | append: '), (min-width: 750px) 50vw, 100vw'

  # No arranjo "card", cada coluna é um bloco sólido #ECF3F9 (.pb-bloco; etapa 8e, item 9: antes era cartão de
  # vidro de conteúdo da v2), preenchimento dentro do painel e vidro escuro de conteúdo no campo noite.
  assign mc_item_class = ''
  if section.settings.layout == 'card'
    case mc_scheme
      when 'surface', 'surface-2'
        assign mc_item_class = ' glass-fill'
      when 'ink'
        assign mc_item_class = ' glass glass--dark-card'
      else
        assign mc_item_class = ' pb-bloco'
    endcase
  endif
-%}

{%- if mc_visible_count > 0 -%}
  {% style %}
    #shopify-section-{{ section.id }} .multicolumn__grid {
      --grid-columns-mobile: {{ section.settings.columns_mobile }};
      --grid-columns-tablet: {{ mc_columns_tablet }};
      --grid-columns-desktop: {{ mc_columns }};
    }
  {% endstyle %}

  <div class="multicolumn multicolumn--{{ section.settings.layout }} multicolumn--align-{{ section.settings.content_align }} pb-scheme--{{ mc_scheme }}{% render 'paginas-blog-surface', scheme: mc_scheme %} pb-pad--{{ section.settings.padding }}{% if mc_bg != blank %} has-section-bg{% endif %}">
    {%- render 'section-background', image: mc_bg, veil: section.settings.background_overlay, index: section.index -%}
    <div class="page-width">
      {%- if mc_has_intro -%}
        <div class="pb-intro pb-intro--{{ section.settings.intro_align }}">
          {%- if section.settings.eyebrow != blank -%}
            <span class="chip pb-intro__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="multicolumn__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="pb-intro__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="grid multicolumn__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.title == blank and block.settings.text == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign mc_has_link = false -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            {%- assign mc_has_link = true -%}
          {%- endif -%}
          <li class="multicolumn__item{{ mc_item_class }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {%- assign mc_alt = block.settings.image.alt | default: block.settings.title | default: shop.name -%}
              <div class="multicolumn__media pb-media pb-media--{{ section.settings.image_ratio }}">
                {{ block.settings.image | image_url: width: 800 | image_tag: widths: '160, 320, 480, 640, 800', sizes: mc_sizes, loading: mc_loading, alt: mc_alt, class: 'multicolumn__image' }}
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <span class="multicolumn__icon">
                {%- render 'icon', name: block.settings.icon, size: 24 -%}
              </span>
            {%- endif -%}

            <div class="multicolumn__body">
              {%- if block.settings.title != blank -%}
                <{{ mc_item_tag }} class="multicolumn__title">{{ block.settings.title | escape }}</{{ mc_item_tag }}>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="multicolumn__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if mc_has_link -%}
                <a href="{{ block.settings.link }}" class="link multicolumn__link">
                  {{- block.settings.link_label | escape -}}
                  {%- if block.settings.title != blank -%}
                    <span class="visually-hidden">: {{ block.settings.title | escape }}</span>
                  {%- endif -%}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="pb-actions pb-actions--center multicolumn__actions">
          <a href="{{ section.settings.button_link }}" class="button button--large button--{{ section.settings.button_style }}">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

