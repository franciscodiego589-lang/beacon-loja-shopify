{{ 'conta-base.css' | asset_url | stylesheet_tag }}
{{ 'conta-auth.css' | asset_url | stylesheet_tag }}
{{ 'section-main-activate-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'conta-password-field.js' | asset_url }}" type="module"></script>

{%- comment -%}
  Ativação de conta (template customers/activate_account, contas de cliente legadas).
  O cliente chega aqui pelo convite enviado pela loja.
  Formulário activate_customer_password conforme a documentação da Shopify:
  customer[password], customer[password_confirmation] e um segundo envio com
  name="decline" para recusar o convite. O botão de recusar usa formnovalidate, para
  não exigir as senhas.
{%- endcomment -%}

{%- liquid
  assign section_image = section.settings.image
  assign auth_class = 'conta-auth'
  if section.settings.show_image
    if section_image != blank
      assign auth_class = auth_class | append: ' conta-auth--has-image'
    else
      assign auth_class = auth_class | append: ' conta-auth--placeholder'
    endif
    if section.settings.image_position == 'left'
      assign auth_class = auth_class | append: ' conta-auth--media-left'
    endif
  else
    assign auth_class = auth_class | append: ' conta-auth--no-media'
  endif

  assign errors_id = 'ActivateErrors-' | append: section.id
-%}

<div class="{{ auth_class }}">
  {%- if section.settings.show_image -%}
    {%- render 'conta-auth-media', image: section_image -%}
  {%- endif -%}

  <div class="conta-auth__body">
    <div class="conta-auth__card conta-activate glass glass--card">
      {%- form 'activate_customer_password', class: 'conta-auth__form conta-activate__form' -%}
        <h1 class="conta-auth__title">{{ 'conta.activate_account.title' | t }}</h1>
        <p class="conta-auth__text">{{ 'conta.activate_account.text' | t }}</p>

        {%- render 'conta-form-errors', form: form, id: errors_id -%}

        {%- liquid
          assign password_invalid = false
          if form.errors
            assign password_invalid = true
          endif

          assign password_id = 'ActivatePassword-' | append: section.id
          assign password_label = 'conta.activate_account.password' | t
          render 'conta-password-field', id: password_id, name: 'customer[password]', label: password_label, autocomplete: 'new-password', required: true, invalid: password_invalid, describedby: errors_id

          assign confirmation_id = 'ActivatePasswordConfirmation-' | append: section.id
          assign confirmation_label = 'conta.activate_account.password_confirmation' | t
          render 'conta-password-field', id: confirmation_id, name: 'customer[password_confirmation]', label: confirmation_label, autocomplete: 'new-password', required: true, invalid: password_invalid, describedby: errors_id
        -%}

        <div class="conta-auth__actions">
          <button type="submit" class="button button--primary button--full button--large">
            {{- 'conta.activate_account.submit' | t -}}
          </button>
          <button type="submit" name="decline" value="{{ 'conta.activate_account.decline' | t }}" class="button button--ghost button--full" formnovalidate>
            {{- 'conta.activate_account.decline' | t -}}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ativação de conta",
  "tag": "section",
  "class": "section-main-activate-account",
  "limit": 1,
  "enabled_on": {
    "templates": ["customers/activate_account"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Tela aberta pelo convite de conta enviado pela loja. Os textos ficam nas traduções do tema (área conta)."
    },
    {
      "type": "header",
      "content": "Imagem"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar imagem",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem lateral",
      "info": "Sem imagem, o computador mostra um espaço reservado e o celular esconde a faixa."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posição da imagem no computador",
      "options": [
        {
          "value": "right",
          "label": "Direita"
        },
        {
          "value": "left",
          "label": "Esquerda"
        }
      ],
      "default": "right"
    }
  ],
  "presets": [
    {
      "name": "Ativação de conta"
    }
  ]
}
{% endschema %}
