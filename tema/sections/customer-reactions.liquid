{{ 'section-customer-reactions.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Área produto. Host de app para reações de cliente (ex.: "Quero" / "Tenho"). Só existe
  conteúdo aqui quando o lojista adiciona um bloco de app: sem bloco, a seção não renderiza
  nada (shopify.dev/docs/storefronts/themes/architecture/blocks/app-blocks, consultado em
  27/09/2026: bloco "@app" não aceita "limit" nem metadado próprio do tema).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="customer-reactions section"{% if section.settings.heading != blank %} aria-labelledby="CustomerReactionsTitle-{{ section.id }}"{% endif %}>
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section-heading">
          <h2 class="section-heading__title" id="CustomerReactionsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}
      <div class="customer-reactions__blocks">
        {%- for block in section.blocks -%}
          <div class="customer-reactions__block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reações de cliente",
  "tag": "div",
  "class": "section-customer-reactions",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Seção sem conteúdo próprio: existe só para hospedar um app (por exemplo, reações \"Quero\"/\"Tenho\"). Adicione o bloco de app da loja em \"Adicionar bloco\"."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (opcional)"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Reações de cliente"
    }
  ]
}
{% endschema %}
