{{ 'paginas-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Conteúdo da página de senha (templates/password.json, layout/password.liquid): mensagem
  editável pelo dono (shop.password_message) e o formulário de senha da própria Shopify
  ({% form 'storefront_password' %}, campo obrigatório name="password").
  O cabeçalho, o rodapé e o logo desta página já estão fixos no layout (fora desta seção).
  Liquid Glass (spec 4.2): mensagem e formulário num cartão de vidro de conteúdo (.glass
  .glass--card) sobre a névoa; o campo ganha a borda #4A6072 de campo dentro de vidro.
{%- endcomment -%}

<div class="main-password">
  <div class="page-width">
    <div class="main-password__inner glass glass--card">
      {%- comment -%}
        Toda página precisa de um título h1 para leitor de tela. Aqui ele é só o nome da loja e
        fica escondido na tela (o logo do layout já mostra o nome): nenhum texto novo aparece.
      {%- endcomment -%}
      <h1 class="visually-hidden">{{ shop.name | escape }}</h1>
      {%- unless shop.password_message == blank -%}
        <div class="main-password__message rte">
          {{ shop.password_message }}
        </div>
      {%- endunless -%}

      {%- form 'storefront_password', class: 'main-password__form pb-form' -%}
        {%- if form.errors -%}
          <div class="pb-status pb-status--error" id="MainPasswordError-{{ section.id }}" role="alert" tabindex="-1" autofocus>
            {%- render 'icon', name: 'help-circle', size: 20 -%}
            <div>
              <p class="pb-status__title">{{ 'paginas_blog.form.error_title' | t }}</p>
              <ul class="pb-status__list">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] | escape }}</li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        <div class="field pb-form__field main-password__field">
          <label class="field__label" for="MainPassword-{{ section.id }}">{{ 'paginas_blog.password.field_label' | t }}</label>
          <input
            type="password"
            id="MainPassword-{{ section.id }}"
            name="password"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="MainPasswordError-{{ section.id }}"{% endif %}
          >
        </div>

        <button type="submit" class="button button--large button--primary main-password__submit">
          {{- 'paginas_blog.password.submit' | t -}}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Senha",
  "tag": "section",
  "class": "section-main-password",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A mensagem vem de Preferências > Proteção por senha, no admin. O formulário de senha é da própria Shopify."
    }
  ],
  "presets": [
    {
      "name": "Senha"
    }
  ]
}
{% endschema %}
