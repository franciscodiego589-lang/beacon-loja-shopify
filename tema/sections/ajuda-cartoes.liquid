{{ 'paginas-blog.css' | asset_url | stylesheet_tag }}
{{ 'ajuda-secoes.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Cartões das páginas de ajuda (maquete de 29/09/2026): "Rastreie seu pedido" e "Se o pedido
  atrasar" (Entregas); "Os prazos, em resumo", "Qual é o seu caso?", "Condições para a
  devolução" e "Como o dinheiro volta" (Trocas e devoluções).
  Blocos, na ordem em que aparecem no editor:
  - cartao: abre um cartão (ícone, destaque, título, texto e até dois botões);
  - item: entra na lista do cartão aberto (marcadores com ícone, ou lista numerada);
  - nota: caixa de destaque dentro do cartão aberto (ícone, título, texto e fonte).
  Regras de exibição:
  - o cartão só aparece com título e com texto, ou com título e pelo menos um item ou nota
    com texto até o próximo cartão; item e nota de um cartão oculto também ficam ocultos;
  - item sem texto (mesmo com título), nota sem texto e botão sem texto ou sem link não
    aparecem;
  - sem cartão visível, a seção não renderiza nada (no editor, fica um aviso no lugar).
  Estilos: padrao (ícone, destaque em chip, título e texto) e resumo (destaque grande, como
  "7 dias", com o título logo abaixo).
  Etapa 8e, item 9 (03/10/2026): o cartão é um bloco sólido #ECF3F9 (.pb-bloco, paginas-blog.css), sem
  borda e sem sombra; antes era cartão de vidro de conteúdo da v2 (.glass .glass--card). A nota dentro do
  cartão é uma linha com fio em cima (sem caixa); a nota solta, fora de cartão, é um bloco #ECF3F9.
{%- endcomment -%}

{%- liquid
  assign ac_card_class = ' pb-bloco'
  case section.settings.color_scheme
    when 'surface', 'surface-2'
      assign ac_card_class = ' glass-fill'
  endcase

  assign ac_card_tag = 'h2'
  if section.settings.heading != blank
    assign ac_card_tag = 'h3'
  endif

  assign ac_has_header_link = false
  if section.settings.link_label != blank and section.settings.link != blank
    assign ac_has_header_link = true
  endif
-%}

{%- comment -%}
  Máquina de estados como a de sections/faq-list.liquid: o cartão abre no bloco "cartao" e só
  fecha quando o próximo cartão abre (ou no fim do laço); a lista abre no primeiro item e fecha
  antes de uma nota, do próximo cartão ou do fim. Abertura e fechamento sempre correspondem 1:1
  na execução, mas com condições diferentes, que o Theme Check não prova estaticamente (check
  UnclosedHTMLElement). Os avisos são falsos positivos; a saída HTML é sempre bem formada.
{%- endcomment -%}
{%- # theme-check-disable UnclosedHTMLElement -%}
{%- capture ac_cards -%}
  {%- assign ac_visible = 0 -%}
  {%- assign ac_card_open = false -%}
  {%- assign ac_list_open = false -%}
  {%- assign ac_list_tag = 'ul' -%}
  {%- assign ac_card_footer = '' -%}
  {%- assign ac_item_n = 0 -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'cartao' -%}
        {%- if ac_list_open -%}</{{ ac_list_tag }}>{%- endif -%}
        {%- if ac_card_open -%}{{ ac_card_footer }}</article>{%- endif -%}
        {%- assign ac_card_open = false -%}
        {%- assign ac_list_open = false -%}

        {%- assign ac_show = false -%}
        {%- if block.settings.title != blank -%}
          {%- if block.settings.text != blank -%}
            {%- assign ac_show = true -%}
          {%- else -%}
            {%- assign ac_offset = forloop.index -%}
            {%- for next_block in section.blocks offset: ac_offset -%}
              {%- if next_block.type == 'cartao' -%}
                {%- break -%}
              {%- endif -%}
              {%- if next_block.type == 'item' and next_block.settings.text != blank -%}
                {%- assign ac_show = true -%}
                {%- break -%}
              {%- endif -%}
              {%- if next_block.type == 'nota' and next_block.settings.text != blank -%}
                {%- assign ac_show = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}

        {%- if ac_show -%}
          {%- assign ac_visible = ac_visible | plus: 1 -%}
          {%- assign ac_item_n = 0 -%}
          {%- assign ac_list_tag = 'ul' -%}
          {%- if block.settings.list_style == 'numerada' -%}
            {%- assign ac_list_tag = 'ol' -%}
          {%- endif -%}
          {%- assign ac_title_id = 'AjudaCartao-' | append: block.id -%}
          {%- liquid
            assign ac_href = block.settings.button_link
            if ac_href == blank and block.settings.button_anchor != blank
              assign ac_href = '#' | append: block.settings.button_anchor
            endif
            assign ac_has_button = false
            if block.settings.button_label != blank and ac_href != blank
              assign ac_has_button = true
            endif
            assign ac_has_button2 = false
            if block.settings.button2_label != blank and block.settings.button2_link != blank
              assign ac_has_button2 = true
            endif
          -%}
          {%- capture ac_card_footer -%}
            {%- if ac_has_button or ac_has_button2 -%}
              <div class="ajuda-cartoes__acoes">
                {%- if ac_has_button -%}
                  {%- if block.settings.button_style == 'link' -%}
                    <a href="{{ ac_href | escape }}" class="link ajuda-cartoes__link">
                      {{- block.settings.button_label | escape -}}
                      {%- render 'icon', name: 'arrow-right', size: 16 -%}
                    </a>
                  {%- else -%}
                    <a href="{{ ac_href | escape }}" class="button button--{{ block.settings.button_style }}">
                      {{- block.settings.button_label | escape -}}
                    </a>
                  {%- endif -%}
                {%- endif -%}
                {%- if ac_has_button2 -%}
                  <a href="{{ block.settings.button2_link }}" class="button button--secondary">
                    {{- block.settings.button2_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          <article class="ajuda-cartoes__cartao{{ ac_card_class }}"{% if block.settings.anchor != blank %} id="{{ block.settings.anchor | handleize }}"{% endif %} aria-labelledby="{{ ac_title_id }}" {{ block.shopify_attributes }}>
            {%- if section.settings.style == 'resumo' -%}
              <div class="ajuda-cartoes__resumo">
                {%- if block.settings.icon != 'none' -%}
                  <span class="ajuda-icone-circulo">{%- render 'icon', name: block.settings.icon, size: 20 -%}</span>
                {%- endif -%}
                {%- if block.settings.destaque != blank -%}
                  <span class="ajuda-cartoes__valor">{{ block.settings.destaque | escape }}</span>
                {%- endif -%}
              </div>
              <{{ ac_card_tag }} class="ajuda-cartoes__titulo ajuda-cartoes__titulo--resumo" id="{{ ac_title_id }}">{{ block.settings.title | escape }}</{{ ac_card_tag }}>
            {%- else -%}
              {%- if block.settings.icon != 'none' or block.settings.destaque != blank -%}
                <div class="ajuda-cartoes__topo">
                  {%- if block.settings.icon != 'none' -%}
                    <span class="ajuda-icone-circulo">{%- render 'icon', name: block.settings.icon, size: 22 -%}</span>
                  {%- endif -%}
                  {%- if block.settings.destaque != blank -%}
                    <span class="chip ajuda-cartoes__chip">{{ block.settings.destaque | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <{{ ac_card_tag }} class="ajuda-cartoes__titulo" id="{{ ac_title_id }}">{{ block.settings.title | escape }}</{{ ac_card_tag }}>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="ajuda-cartoes__texto rte">{{ block.settings.text }}</div>
            {%- endif -%}
          {%- assign ac_card_open = true -%}
        {%- endif -%}

      {%- when 'item' -%}
        {%- if ac_card_open -%}
          {%- if block.settings.text != blank -%}
            {%- unless ac_list_open -%}
              <{{ ac_list_tag }} class="ajuda-cartoes__lista ajuda-cartoes__lista--{{ ac_list_tag }}" role="list">
              {%- assign ac_list_open = true -%}
            {%- endunless -%}
            {%- assign ac_item_n = ac_item_n | plus: 1 -%}
            <li class="ajuda-cartoes__item" {{ block.shopify_attributes }}>
              {%- if ac_list_tag == 'ol' -%}
                <span class="ajuda-cartoes__numero" aria-hidden="true">{{ ac_item_n }}</span>
              {%- elsif block.settings.icon != 'none' -%}
                <span class="ajuda-cartoes__item-icone">{%- render 'icon', name: block.settings.icon, size: 18 -%}</span>
              {%- endif -%}
              <span class="ajuda-cartoes__item-corpo">
                {%- if block.settings.title != blank -%}
                  <strong class="ajuda-cartoes__item-titulo">{{ block.settings.title | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="ajuda-cartoes__item-texto">{{ block.settings.text }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endif -%}
        {%- endif -%}

      {%- when 'nota' -%}
        {%- if ac_card_open and block.settings.text != blank -%}
          {%- if ac_list_open -%}</{{ ac_list_tag }}>{%- endif -%}
          {%- assign ac_list_open = false -%}
          <div class="ajuda-nota ajuda-cartoes__nota" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="ajuda-nota__icone">{%- render 'icon', name: block.settings.icon, size: 20 -%}</span>
            {%- endif -%}
            <div class="ajuda-nota__corpo">
              {%- if block.settings.title != blank -%}
                <p class="ajuda-nota__titulo">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              <div class="ajuda-nota__texto rte">{{ block.settings.text }}</div>
              {%- if block.settings.source != blank -%}
                <p class="ajuda-nota__fonte">{{ block.settings.source | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
  {%- if ac_list_open -%}</{{ ac_list_tag }}>{%- endif -%}
  {%- if ac_card_open -%}{{ ac_card_footer }}</article>{%- endif -%}
{%- endcapture -%}
{%- # theme-check-enable UnclosedHTMLElement -%}

{%- if ac_visible > 0 -%}
  {% style %}
    #shopify-section-{{ section.id }} .ajuda-cartoes__grade {
      --ajuda-colunas: {{ section.settings.columns_desktop }};
    }
  {% endstyle %}
  <div class="ajuda-cartoes ajuda-cartoes--{{ section.settings.style }} pb-scheme--{{ section.settings.color_scheme }}{% render 'paginas-blog-surface', scheme: section.settings.color_scheme %} pb-pad--{{ section.settings.padding }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
    <div class="page-width">
      {%- if section.settings.heading != blank or section.settings.text != blank or ac_has_header_link -%}
        <div class="ajuda-cabecalho">
          <div class="ajuda-cabecalho__textos">
            {%- if section.settings.heading != blank -%}
              <h2 class="ajuda-cabecalho__titulo">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="ajuda-cabecalho__texto rte">{{ section.settings.text }}</div>
            {%- endif -%}
          </div>
          {%- if ac_has_header_link -%}
            <a href="{{ section.settings.link }}" class="link ajuda-cabecalho__link">
              {{- section.settings.link_label | escape -}}
              {%- render 'icon', name: 'arrow-right', size: 16 -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ajuda-cartoes__grade"{% if section.settings.heading == blank and section.settings.region_label != blank %} role="region" aria-label="{{ section.settings.region_label | escape }}"{% endif %}>
        {{ ac_cards }}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width ajuda-aviso-editor">
    <p>Cartões: esta seção aparece na loja quando algum cartão tiver título e texto, ou título e um item preenchido.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ajuda: cartões",
  "tag": "section",
  "class": "section-ajuda-cartoes",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link ao lado do título"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link ao lado do título"
    },
    {
      "type": "text",
      "id": "region_label",
      "label": "Nome da área (leitor de tela)",
      "info": "Usado quando a seção não tem título. Ex.: Rastreio e atrasos."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Âncora da seção",
      "info": "Opcional. Ex.: base-legal."
    },
    {
      "type": "header",
      "content": "Cartões"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo dos cartões",
      "options": [
        { "value": "padrao", "label": "Ícone, destaque em chip, título e texto" },
        { "value": "resumo", "label": "Destaque grande com o título abaixo" }
      ],
      "default": "padrao"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cartões por linha no computador",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Sem painel (névoa)" },
        { "value": "surface", "label": "Painel de vidro" },
        { "value": "surface-2", "label": "Painel de vidro (reserva azul clara)" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Espaçamento vertical",
      "options": [
        { "value": "small", "label": "Pequeno" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "cartao",
      "name": "Cartão",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "none", "label": "Sem ícone" },
            { "value": "map-pin", "label": "Localização" },
            { "value": "truck", "label": "Entrega" },
            { "value": "clock", "label": "Relógio" },
            { "value": "calendar", "label": "Calendário" },
            { "value": "alert-triangle", "label": "Alerta" },
            { "value": "refresh", "label": "Troca" },
            { "value": "arrow-left", "label": "Voltar" },
            { "value": "bag", "label": "Pedido" },
            { "value": "jar", "label": "Pote" },
            { "value": "check-circle", "label": "Confirmado" },
            { "value": "cashback", "label": "Dinheiro de volta" },
            { "value": "card", "label": "Cartão de pagamento" },
            { "value": "file-text", "label": "Documento" },
            { "value": "shield-check", "label": "Escudo" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "destaque",
          "label": "Destaque",
          "info": "Ex.: 7 dias. No estilo padrão vira um chip; no estilo resumo, número grande."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "select",
          "id": "list_style",
          "label": "Itens deste cartão",
          "options": [
            { "value": "marcadores", "label": "Marcadores com ícone" },
            { "value": "numerada", "label": "Lista numerada" }
          ],
          "default": "marcadores"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Âncora do cartão",
          "info": "Opcional. Ex.: caso-desistencia."
        },
        {
          "type": "header",
          "content": "Botões"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão principal"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link do botão principal"
        },
        {
          "type": "text",
          "id": "button_anchor",
          "label": "Âncora do botão principal",
          "info": "Usada quando o link está vazio. Ex.: passo-a-passo."
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Estilo do botão principal",
          "options": [
            { "value": "primary", "label": "Azul" },
            { "value": "dark", "label": "Azul-marinho" },
            { "value": "secondary", "label": "Contorno" },
            { "value": "link", "label": "Link com seta" }
          ],
          "default": "primary"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "Texto do botão secundário"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Link do botão secundário"
        }
      ]
    },
    {
      "type": "item",
      "name": "Item do cartão",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone (lista com marcadores)",
          "options": [
            { "value": "none", "label": "Sem ícone" },
            { "value": "check-circle", "label": "Confirmado" },
            { "value": "check", "label": "Visto" },
            { "value": "message", "label": "Mensagem" },
            { "value": "user", "label": "Conta" },
            { "value": "map-pin", "label": "Localização" },
            { "value": "file-text", "label": "Documento" },
            { "value": "card", "label": "Cartão de pagamento" },
            { "value": "coin", "label": "Moeda" },
            { "value": "cashback", "label": "Dinheiro de volta" },
            { "value": "tag", "label": "Etiqueta" }
          ],
          "default": "check-circle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título do item"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto do item",
          "info": "Item sem texto não aparece, mesmo com título."
        }
      ]
    },
    {
      "type": "nota",
      "name": "Nota do cartão",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "none", "label": "Sem ícone" },
            { "value": "shield-check", "label": "Escudo" },
            { "value": "alert-triangle", "label": "Alerta" },
            { "value": "help-circle", "label": "Ajuda" },
            { "value": "file-text", "label": "Documento" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título da nota"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto da nota",
          "info": "Sem texto, a nota não aparece."
        },
        {
          "type": "text",
          "id": "source",
          "label": "Fonte (letra menor)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ajuda: cartões",
      "blocks": [
        { "type": "cartao" },
        { "type": "item" },
        { "type": "cartao" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
