{{ 'section-hero-slideshow.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Banner principal da home. Carrossel em tela cheia (modo "fade" de <carousel-slider>),
  proporção 3:1 no computador e 4:5 no celular (arte diferente por breakpoint). Sem nenhum
  slide com imagem, a seção não renderiza nada.

  Imagem de cada slide (auditoria de interface, 28/09/2026): um único <picture>. O <source>
  com media="(max-width: 749px)" leva a arte do celular e o <img> leva a do computador; o
  navegador baixa só a fonte que vale para a largura da tela (antes eram dois <img>, um
  escondido por CSS, e os dois eram baixados). A foto do primeiro slide é a candidata a LCP
  da home: sai com loading="eager" e fetchpriority="high"; os demais slides, com
  loading="lazy" (o carousel-slider.js troca para "eager" no slide seguinte, e o navegador
  continua escolhendo uma fonte só).
{%- endcomment -%}

{%- liquid
  assign hero_slide_count = 0
  for block in section.blocks
    if block.type == 'slide' and block.settings.image != blank
      assign hero_slide_count = hero_slide_count | plus: 1
    endif
  endfor
-%}

{%- if hero_slide_count > 0 -%}
  {%- comment -%}
    A <section> com aria-label é a região do carrossel (padrão APG: região com nome e
    aria-roledescription). O <carousel-slider> dentro dela é só o comportamento.

    Liquid Glass (spec 8.2): setas em vidro funcional fino COM desfoque (.glass--thin
    .glass--blur), porque ficam sobre a foto; é uma das peças da regra 1 da seção 10.
    Pausa em vidro fino sem desfoque, círculo de 32 px com área de toque de 44 (.lg-hit).
    Bolinhas sobre a névoa (section-hero-slideshow.css).
  {%- endcomment -%}
  <section
    class="hero-slideshow"
    aria-label="{{ 'home.hero.region_label' | t }}"
    {% if hero_slide_count > 1 %}aria-roledescription="{{ 'home.hero.roledescription' | t }}"{% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <h1 class="visually-hidden">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    <carousel-slider
      class="hero-slideshow__carousel"
      data-mode="fade"
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.interval }}"
      data-loop="true"
    >
      <div class="hero-slideshow__track" data-carousel-track>
        {%- assign hero_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' and block.settings.image != blank -%}
            {%- assign hero_index = hero_index | plus: 1 -%}
            {%- liquid
              assign hero_alt = block.settings.alt | default: section.settings.heading | default: shop.name
              assign hero_label = 'home.hero.slide_label' | t: number: hero_index, total: hero_slide_count
              assign hero_loading = 'lazy'
              assign hero_priority = 'auto'
              if hero_index == 1
                assign hero_loading = 'eager'
                assign hero_priority = 'high'
              endif
              assign hero_mobile_image = block.settings.image_mobile | default: block.settings.image
            -%}
            <div
              class="hero-slideshow__slide"
              data-carousel-slide
              role="group"
              aria-roledescription="{{ 'home.hero.slide_roledescription' | t }}"
              aria-label="{{ hero_label }}"
              {% if hero_index > 1 %}hidden{% endif %}
              {{ block.shopify_attributes }}
            >
              {%- capture hero_media -%}
                <picture class="hero-slideshow__picture">
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ hero_mobile_image | image_url: width: 390 }} 390w, {{ hero_mobile_image | image_url: width: 600 }} 600w, {{ hero_mobile_image | image_url: width: 750 }} 750w, {{ hero_mobile_image | image_url: width: 900 }} 900w"
                    sizes="100vw"
                    width="900"
                    height="1125"
                  >
                  {{ block.settings.image | image_url: width: 2880 | image_tag: widths: '750, 990, 1440, 1920, 2880', sizes: '100vw', loading: hero_loading, fetchpriority: hero_priority, alt: hero_alt, class: 'hero-slideshow__image' }}
                </picture>
              {%- endcapture -%}
              {%- comment -%}
                Sem tabindex="-1": o slide escondido já sai da ordem do Tab pelo atributo hidden
                (display: none); quando ele aparece, o link precisa ser alcançável pelo teclado.
              {%- endcomment -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="hero-slideshow__link">{{ hero_media }}</a>
              {%- else -%}
                {{ hero_media }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if hero_slide_count > 1 -%}
        <button type="button" class="icon-button glass glass--thin glass--blur glass--interactive hero-slideshow__nav hero-slideshow__nav--prev" aria-label="{{ 'home.hero.previous' | t }}" data-carousel-prev>
          {% render 'icon', name: 'chevron-left', size: 20 %}
        </button>
        <button type="button" class="icon-button glass glass--thin glass--blur glass--interactive hero-slideshow__nav hero-slideshow__nav--next" aria-label="{{ 'home.hero.next' | t }}" data-carousel-next>
          {% render 'icon', name: 'chevron-right', size: 20 %}
        </button>

        <div class="hero-slideshow__controls">
          <div class="hero-slideshow__dots" role="group" aria-label="{{ 'home.hero.dots_label' | t }}">
            {%- for i in (1..hero_slide_count) -%}
              <button
                type="button"
                class="hero-slideshow__dot"
                data-carousel-dot="{{ forloop.index0 }}"
                aria-label="{{ 'home.hero.go_to' | t: number: forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              ></button>
            {%- endfor -%}
          </div>
          {%- comment -%}
            Botão de rotação no padrão APG: o rótulo muda ("Pausar" / "Retomar"), sem
            aria-pressed (um botão de alternância manteria o rótulo fixo).
          {%- endcomment -%}
          {%- if section.settings.autoplay -%}
            <button
              type="button"
              class="icon-button glass glass--thin glass--interactive lg-hit hero-slideshow__pause"
              aria-label="{{ 'home.hero.pause' | t }}"
              data-carousel-pause
              data-label-pause="{{ 'home.hero.pause' | t }}"
              data-label-play="{{ 'home.hero.play' | t }}"
            >
              {% render 'icon', name: 'pause', size: 16 %}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </carousel-slider>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Banner principal",
  "tag": "section",
  "class": "section-hero-slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título oculto (SEO)",
      "info": "Não aparece na tela. Identifica a página para leitores de tela e buscadores.",
      "default": "Beacon Labs: suplementos alimentares"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Trocar banners automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Tempo de cada banner",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (computador)",
          "info": "Proporção 3:1. Sugestão: 2880 × 960 px."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem (celular)",
          "info": "Proporção 4:5. Sem esta imagem, a do computador é reaproveitada, cortada no centro."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Texto alternativo",
          "info": "Descreva a imagem e a oferta para quem usa leitor de tela."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner principal",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
