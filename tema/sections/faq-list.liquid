      "label": "Título",
      "default": "Perguntas frequentes"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Nível do título",
      "options": [
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h1",
          "label": "h1"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto de apoio"
    },
    {
      "type": "select",
      "id": "intro_align",
      "label": "Alinhamento do título",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Painéis no computador",
      "info": "Com grupos, os painéis podem ficar lado a lado.",
      "options": [
        {
          "value": "one",
          "label": "Uma coluna"
        },
        {
          "value": "two",
          "label": "Duas colunas"
        },
        {
          "value": "categorias",
          "label": "Categorias ao lado (central de ajuda)"
        },
