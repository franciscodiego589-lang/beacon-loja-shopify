      ],
      "default": "one"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link abaixo do texto de apoio"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link abaixo do texto de apoio"
    },
    {
      "type": "header",
      "content": "Categorias ao lado"
