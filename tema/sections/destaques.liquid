{{ 'section-destaques.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Destaques da home (redesenho v3, tarefa 4b, parte 1; alvo.css linhas 190 a 201, 371 a 373 e 414 a 422;
  home.html linhas 73 a 101). Grade de duas colunas com blocos claros (--color-photo-bg, raio --radius-tile),
  sem vidro e sem sombra:
  - tile (até 2): um produto. Linha pequena, título, frase, preço "A partir de", dois botões e a foto do pote.
  - tile_largo (até 1): linha pequena, título, frase, botão com link e até três produtos só para as fotos.
  Quem decide a ordem é o editor de tema (a ordem dos blocos); o bloco largo ocupa a linha inteira.

  Produto: o nome sai sempre de snippets/v3-nome-visivel (já escapado: não passa por | escape de novo) e a
  classe da foto sai de snippets/v3-classe-foto (máscara do pote solto ou quadro, emenda C9). "Comprar" é um
  link para a página do produto (não adiciona ao carrinho: o destaque não escolhe kit). "Saiba mais" leva ao
  link escolhido ou, em branco, também à página do produto.
  Preço: chave existente colecao.grid.price_from ("A partir de {{ amount }}") com o menor preço do produto
  (product.price_min). O espaço entre "R$" e o número é não separável e a linha do preço não quebra (mesma
  técnica do card, component-price.css). Produto esgotado: no lugar do preço aparece "Esgotado"; o link
  continua levando à página do produto, que mostra o estado.
  Linha reservada: se algum bloco tem frase, os outros reservam a mesma linha vazia (classe destaques--reserva),
  para título, preço, botões e foto ficarem alinhados lado a lado.

  Fotos: primeira mídia do produto, <img> escrito aqui (e não por image_tag) para o texto alternativo, que já
  vem escapado pelo snippet do nome, não ser escapado duas vezes. width e height reais, sizes pelo tamanho na
  tela, loading="lazy" (a seção nunca está na primeira tela). Sem foto, entra o espaço reservado do tema.

  Segurança (S1 a S5): ajustes text com | escape; link só de tipo url; nenhum ajuste html ou liquid; nenhum
  <script>; nenhuma chave de tradução com _html. Aviso do editor: só aparece com request.design_mode.
{%- endcomment -%}

{%- liquid
  assign dst_reserva = false
  assign dst_tem_bloco = false
  for block in section.blocks
    if block.type == 'tile'
      if block.settings.product != blank
        assign dst_tem_bloco = true
        if block.settings.subtitle != blank
          assign dst_reserva = true
        endif
      endif
    elsif block.type == 'tile_largo'
      if block.settings.title != blank or block.settings.subtitle != blank
        assign dst_tem_bloco = true
      endif
    endif
  endfor

  assign dst_mostrar = dst_tem_bloco
  if request.design_mode and section.blocks.size > 0
    assign dst_mostrar = true
  endif
-%}

{%- if dst_mostrar -%}
  <div class="destaques page-width{% if dst_reserva %} destaques--reserva{% endif %}" role="region" aria-label="{{ 'home.destaques.region_label' | t }}">
    <div class="destaques__grade">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'tile' -%}
            {%- assign dst_produto = block.settings.product -%}
            {%- if dst_produto != blank -%}
              {%- liquid
                capture dst_nome_html
                  render 'v3-nome-visivel', produto: dst_produto, modo: 'html'
                endcapture
                capture dst_nome_txt
                  render 'v3-nome-visivel', produto: dst_produto, modo: 'texto'
                endcapture
                capture dst_foto_classe
                  render 'v3-classe-foto', product: dst_produto
                endcapture
                assign dst_nome_html = dst_nome_html | strip
                assign dst_nome_txt = dst_nome_txt | strip
                assign dst_foto_classe = dst_foto_classe | strip
                assign dst_id = section.id | append: '-' | append: block.id | handleize | prepend: 'destaque-'

                if block.settings.title != blank
                  assign dst_titulo = block.settings.title | escape
                else
                  assign dst_titulo = dst_nome_html
                endif

                assign dst_link_2 = block.settings.secondary_link | default: dst_produto.url

                assign dst_preco = ''
                if block.settings.show_price
                  if dst_produto.available
                    assign dst_valor = dst_produto.price_min | money | replace: ' ', '&nbsp;'
                    assign dst_preco = 'colecao.grid.price_from' | t: amount: dst_valor
                  else
                    assign dst_preco = 'fundacao.price.sold_out' | t
                  endif
                endif

                assign dst_midia = dst_produto.featured_media
              -%}
              <article class="destaques__tile" aria-labelledby="{{ dst_id }}-titulo" {{ block.shopify_attributes }}>
                <div class="destaques__texto">
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="destaques__linha v3-eyebrow">{{ block.settings.eyebrow | escape }}</p>
                  {%- endif -%}
                  <h2 class="destaques__titulo" id="{{ dst_id }}-titulo">{{ dst_titulo }}</h2>
                  {%- if block.settings.subtitle != blank or dst_preco != blank -%}
                    <p class="destaques__frase">
                      {%- if block.settings.subtitle != blank or dst_reserva -%}
                        <span class="destaques__frase-texto">{{ block.settings.subtitle | escape }}</span>
                      {%- endif -%}
                      {%- if dst_preco != blank -%}
                        <span class="destaques__preco">{{ dst_preco }}</span>
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank or block.settings.secondary_label != blank -%}
                    <div class="destaques__botoes">
                      {%- if block.settings.button_label != blank -%}
                        <a class="button button--primary" href="{{ dst_produto.url }}">{{ block.settings.button_label | escape }}<span class="visually-hidden"> {{ dst_nome_txt }}</span></a>
                      {%- endif -%}
                      {%- if block.settings.secondary_label != blank -%}
                        <a class="button button--secondary" href="{{ dst_link_2 | escape }}">{{ block.settings.secondary_label | escape }}<span class="visually-hidden"> {{ dst_nome_txt }}</span></a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
                {%- if dst_midia != blank -%}
                  <img
                    class="destaques__foto {{ dst_foto_classe | escape }}"
                    src="{{ dst_midia | image_url: width: 860 }}"
                    srcset="{{ dst_midia | image_url: width: 320 }} 320w, {{ dst_midia | image_url: width: 430 }} 430w, {{ dst_midia | image_url: width: 640 }} 640w, {{ dst_midia | image_url: width: 860 }} 860w"
                    sizes="(min-width: 1081px) 430px, (min-width: 761px) min(430px, calc((100vw - 68px) / 2)), min(320px, calc(100vw - 40px))"
                    width="860"
                    height="{{ 860 | divided_by: dst_midia.aspect_ratio | round }}"
                    loading="lazy"
                    decoding="async"
                    alt="{{ dst_nome_txt }}"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'destaques__foto destaques__placeholder' }}
                {%- endif -%}
              </article>
            {%- elsif request.design_mode -%}
              <div class="destaques__tile destaques__tile--vazio" {{ block.shopify_attributes }}>
                <p class="destaques__aviso">
                  <span class="visually-hidden">{{ 'home.general.editor_only' | t }}</span>
                  {{ 'home.destaques.editor_empty' | t }}
                </p>
              </div>
            {%- endif -%}

          {%- when 'tile_largo' -%}
            {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
              {%- assign dst_id = section.id | append: '-' | append: block.id | handleize | prepend: 'destaque-' -%}
              <article class="destaques__tile destaques__tile--largo"{% if block.settings.title != blank %} aria-labelledby="{{ dst_id }}-titulo"{% endif %} {{ block.shopify_attributes }}>
                <div class="destaques__texto">
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="destaques__linha v3-eyebrow">{{ block.settings.eyebrow | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h2 class="destaques__titulo" id="{{ dst_id }}-titulo">{{ block.settings.title | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <p class="destaques__frase"><span class="destaques__frase-texto">{{ block.settings.subtitle | escape }}</span></p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                    <div class="destaques__botoes">
                      <a class="button button--primary" href="{{ block.settings.button_link | escape }}">{{ block.settings.button_label | escape }}</a>
                    </div>
                  {%- endif -%}
                </div>
                {%- if block.settings.product_1 != blank or block.settings.product_2 != blank or block.settings.product_3 != blank -%}
                  <div class="destaques__fotos">
                    {%- for dst_i in (1..3) -%}
                      {%- liquid
                        assign dst_chave = 'product_' | append: dst_i
                        assign dst_produto = block.settings[dst_chave]
                      -%}
                      {%- if dst_produto != blank -%}
                        {%- liquid
                          capture dst_nome_txt
                            render 'v3-nome-visivel', produto: dst_produto, modo: 'texto'
                          endcapture
                          capture dst_foto_classe
                            render 'v3-classe-foto', product: dst_produto
                          endcapture
                          assign dst_nome_txt = dst_nome_txt | strip
                          assign dst_foto_classe = dst_foto_classe | strip
                          assign dst_midia = dst_produto.featured_media
                        -%}
                        {%- if dst_midia != blank -%}
                          <img
                            class="destaques__foto {{ dst_foto_classe | escape }}"
                            src="{{ dst_midia | image_url: width: 500 }}"
                            srcset="{{ dst_midia | image_url: width: 160 }} 160w, {{ dst_midia | image_url: width: 250 }} 250w, {{ dst_midia | image_url: width: 340 }} 340w, {{ dst_midia | image_url: width: 500 }} 500w"
                            sizes="(min-width: 1081px) 250px, (min-width: 761px) min(170px, 15.7vw), calc((100vw - 40px) / 3)"
                            width="500"
                            height="{{ 500 | divided_by: dst_midia.aspect_ratio | round }}"
                            loading="lazy"
                            decoding="async"
                            alt="{{ dst_nome_txt }}"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'destaques__foto destaques__placeholder' }}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </article>
            {%- elsif request.design_mode -%}
              <div class="destaques__tile destaques__tile--largo destaques__tile--vazio" {{ block.shopify_attributes }}>
                <p class="destaques__aviso">
                  <span class="visually-hidden">{{ 'home.general.editor_only' | t }}</span>
                  {{ 'home.destaques.editor_empty_largo' | t }}
                </p>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Destaques",
  "tag": "section",
  "class": "section-destaques",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Destaque de produto",
      "limit": 2,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produto",
          "info": "Sem produto, o bloco não aparece na loja."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Linha pequena",
          "info": "Um fato do produto, como a categoria da loja. Sem palavra de benefício."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "info": "Em branco: usa o nome do produto."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Frase",
          "info": "Opcional. Aparece abaixo do título."
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Mostrar o preço A partir de",
          "default": true
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão 1",
          "info": "O botão 1 leva à página do produto.",
          "default": "Comprar"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Texto do botão 2",
          "default": "Saiba mais"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Link do botão 2",
          "info": "Em branco: leva à página do produto."
        }
      ]
    },
    {
      "type": "tile_largo",
      "name": "Destaque largo",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Linha pequena"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Frase"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link do botão",
          "info": "Sem link, o botão não aparece."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Foto 1: produto"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Foto 2: produto"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Foto 3: produto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Destaques",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        {
          "type": "tile_largo",
          "settings": {
            "eyebrow": "Kits",
            "title": "Monte seu kit.",
            "subtitle": "Escolha 1, 3 ou 6 potes de cada produto. Quanto mais tempo, maior o desconto.",
            "button_label": "Montar meu kit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
