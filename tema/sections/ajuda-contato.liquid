{{ 'paginas-blog.css' | asset_url | stylesheet_tag }}
{{ 'ajuda-secoes.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Faixa de contato do fim das páginas de ajuda (maquete de 29/09/2026): "Não encontrou sua
  resposta?", "Ainda precisa de ajuda?" e "Ainda com dúvida?".
  Cartão de vidro com título, texto e botão à esquerda e os canais de atendimento à direita.
  Bloco canal: rótulo, valor, link e nota. O canal só aparece com o valor preenchido. Sem
  link, um valor com "@" vira link de e-mail (mailto:); qualquer outro fica como texto.
  Sem título, texto, botão e canal visível, a seção não renderiza nada.
  Liquid Glass (spec 4.2 e P3): cartão de vidro de conteúdo sobre a névoa; os canais são
  preenchimento dentro dele, nunca vidro sobre vidro.
{%- endcomment -%}

{%- liquid
  assign ct_canais = 0
  for block in section.blocks
    if block.settings.valor != blank
      assign ct_canais = ct_canais | plus: 1
    endif
  endfor

  assign ct_has_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign ct_has_button = true
  endif

  assign ct_has_content = false
  if section.settings.heading != blank or section.settings.text != blank or ct_has_button or ct_canais > 0
    assign ct_has_content = true
  endif

-%}

{%- if ct_has_content -%}
  <div class="ajuda-contato pb-pad--{{ section.settings.padding }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
    <div class="page-width">
      <div class="ajuda-contato__cartao pb-bloco{% if ct_canais > 0 %} ajuda-contato__cartao--com-canais{% endif %}">
        <div class="ajuda-contato__textos">
          {%- if section.settings.icon != 'none' -%}
            <span class="ajuda-icone-circulo">{%- render 'icon', name: section.settings.icon, size: 22 -%}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="ajuda-contato__titulo">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="ajuda-contato__texto rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if ct_has_button -%}
            <a href="{{ section.settings.button_link }}" class="button button--large button--{{ section.settings.button_style }} ajuda-contato__botao">
              {{- section.settings.button_label | escape -}}
              {%- render 'icon', name: 'arrow-right', size: 18 -%}
            </a>
          {%- endif -%}
        </div>

        {%- if ct_canais > 0 -%}
          <ul class="ajuda-contato__canais" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.valor != blank -%}
                {%- liquid
                  assign ct_href = block.settings.link
                  if ct_href == blank and block.settings.valor contains '@'
                    assign ct_href = 'mailto:' | append: block.settings.valor
                  endif
                -%}
                {%- capture ct_inner -%}
                  {%- if block.settings.icon != 'none' -%}
                    <span class="ajuda-icone-circulo ajuda-icone-circulo--pequeno">{%- render 'icon', name: block.settings.icon, size: 20 -%}</span>
                  {%- endif -%}
                  {%- if block.settings.rotulo != blank -%}
                    <span class="eyebrow ajuda-contato__rotulo">{{ block.settings.rotulo | escape }}</span>
                  {%- endif -%}
                  <span class="ajuda-contato__valor">{{ block.settings.valor | escape }}</span>
                  {%- if block.settings.nota != blank -%}
                    <span class="ajuda-contato__nota">{{ block.settings.nota | escape }}</span>
                  {%- endif -%}
                {%- endcapture -%}
                <li class="ajuda-contato__canal-item" {{ block.shopify_attributes }}>
                  {%- if ct_href != blank -%}
                    <a href="{{ ct_href | escape }}" class="ajuda-contato__canal glass-fill lg-fill-link">{{ ct_inner }}</a>
                  {%- else -%}
                    <div class="ajuda-contato__canal glass-fill">{{ ct_inner }}</div>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ajuda: contato",
  "tag": "section",
  "class": "section-ajuda-contato",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Âncora da seção",
      "default": "contato",
      "info": "Links para #contato levam a esta faixa."
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Ícone acima do título",
      "options": [
        { "value": "none", "label": "Sem ícone" },
        { "value": "chat", "label": "Conversa" },
        { "value": "help-circle", "label": "Ajuda" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo do botão",
      "options": [
        { "value": "primary", "label": "Azul" },
        { "value": "dark", "label": "Azul-marinho" },
        { "value": "secondary", "label": "Contorno" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Espaçamento vertical",
      "options": [
        { "value": "small", "label": "Pequeno" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "canal",
      "name": "Canal de atendimento",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "none", "label": "Sem ícone" },
            { "value": "message", "label": "Mensagem (e-mail)" },
            { "value": "chat", "label": "Conversa (WhatsApp ou chat)" },
            { "value": "clock", "label": "Relógio (horário)" },
            { "value": "map-pin", "label": "Localização" }
          ],
          "default": "message"
        },
        {
          "type": "text",
          "id": "rotulo",
          "label": "Rótulo",
          "info": "Ex.: E-mail, WhatsApp, Horário."
        },
        {
          "type": "text",
          "id": "valor",
          "label": "Valor",
          "info": "O canal só aparece com o valor preenchido. Com @, vira link de e-mail."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Opcional. Ex.: o link do WhatsApp."
        },
        {
          "type": "text",
          "id": "nota",
          "label": "Nota (letra menor)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ajuda: contato"
    }
  ]
}
{% endschema %}
