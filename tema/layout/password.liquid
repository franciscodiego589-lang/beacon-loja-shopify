<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'pt-BR' }}">
  <head>
    {%- comment -%}
      Trecho comum aos dois layouts (snippets/head-comum.liquid). A página de senha não usa a
      fonte dos títulos: só a do texto é pré-carregada.
    {%- endcomment -%}
    {% render 'head-comum', preload_heading_font: false %}
    <meta name="robots" content="noindex">

    <title>{{ shop.name | escape }}</title>

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'liquid-glass.css' | asset_url | stylesheet_tag }}
    {{ 'layout-password.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Nenhum script de componente aqui: nem o layout nem sections/main-password.liquid usam custom
      element (auditoria de arquitetura, 28/09/2026: global.js e details-disclosure.js eram
      carregados sem uso). Seção que precisar de um carrega o próprio script, e o importmap acima
      continua valendo para ela.
    {%- endcomment -%}
  </head>

  <body class="password-page">
    <a class="skip-link" href="#MainContent">{{ 'fundacao.accessibility.skip_to_content' | t }}</a>

    <header class="password-header">
      <div class="password-header__inner page-width">
        {%- assign password_logo_height = settings.logo_width | times: 91.29 | divided_by: 231.3 | round -%}
        <a href="{{ routes.root_url }}" class="password-header__logo">
          <img
            src="{{ 'logo-beacon-labs.svg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="{{ settings.logo_width }}"
            height="{{ password_logo_height }}"
            class="password-header__logo-image"
          >
        </a>
      </div>
    </header>

    <main id="MainContent" class="main-content password-main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <footer class="password-footer">
      <div class="password-footer__inner page-width">
        <p class="password-footer__text">{{ 'fundacao.password.protected' | t }}</p>
        <p class="password-footer__admin">
          {{ 'fundacao.password.owner' | t }}
          <a href="/admin" class="link password-footer__admin-link">{{ 'fundacao.password.admin_link' | t }}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
