{%- comment -%}
  Ícones SVG de traço (grade 24 × 24), decorativos (aria-hidden).
  Parâmetros:
  - name: nome do ícone (lista abaixo)
  - size: largura e altura em px (padrão 24)
  - class: classe extra (opcional)
  - stroke: espessura do traço (opcional; cada ícone tem um padrão)

  Nomes: truck, search, zoom-in, user, heart, bag, menu, chevron-down, chevron-up,
  chevron-left, chevron-right, arrow-right, arrow-left, tag, filter, funnel, sort,
  close, x-bold, check, check-circle, plus, minus, star, play, pause, lock, card,
  shield-check, shield-plus, badge-check, zap, bulb, joint, sparkles, sparkle,
  gut, moon, sun, leaf, dumbbell, refresh, cashback, coin, waves, image, capsule,
  capsule-h, jar, clock, calendar, help-circle, eye-off, flame, map-pin,
  thumbs-up, message, chat, trash, instagram, youtube, facebook, tiktok, file-text,
  alert-triangle, list
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 24
  assign icon_fill = 'none'
  assign icon_stroke = '2'
  case name
    when 'star', 'play'
      assign icon_fill = 'currentColor'
    when 'chevron-down', 'chevron-up'
      assign icon_stroke = '2.2'
    when 'close'
      assign icon_stroke = '2.4'
    when 'check', 'x-bold'
      assign icon_stroke = '3'
    when 'zap', 'shield-plus', 'bulb', 'joint', 'sparkles', 'gut', 'moon', 'dumbbell'
      assign icon_stroke = '1.8'
    when 'image', 'calendar', 'badge-check'
      assign icon_stroke = '1.6'
  endcase
  if stroke != blank
    assign icon_stroke = stroke
  endif
-%}
<svg class="icon icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="{{ icon_fill }}"{% if name != 'star' %} stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round"{% endif %} aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'zoom-in' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-9.3-8.8A5.3 5.3 0 0 1 12 6.1a5.3 5.3 0 0 1 9.3 5.1C19 15.6 12 20 12 20z"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'menu' -%}
      <path d="M4 6h16M4 12h16M4 18h16"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}
      <path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'tag' -%}
      <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>
    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'funnel' -%}
      <path d="M4 5h16l-6 8v6l-4-2v-4z"/>
    {%- when 'sort' -%}
      <path d="M7 4v16M3 16l4 4 4-4M17 20V4M13 8l4-4 4 4"/>
    {%- when 'close' -%}
      <path d="M18 6 6 18M6 6l12 12"/>
    {%- when 'x-bold' -%}
      <path d="M7 7l10 10M17 7 7 17"/>
    {%- when 'check' -%}
      <path d="m5 12 5 5 9-10"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'star' -%}
      <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/>
    {%- when 'play' -%}
      <path d="M8 5v14l11-7z"/>
    {%- when 'pause' -%}
      <path d="M9 5v14M15 5v14"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
    {%- when 'card' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/>
    {%- when 'shield-check' -%}
      <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'shield-plus' -%}
      <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="M12 9v6M9 12h6"/>
    {%- when 'badge-check' -%}
      <path d="M12 3l2.4 1.8 3-.2.9 2.9 2.5 1.7-1 2.8 1 2.8-2.5 1.7-.9 2.9-3-.2L12 21l-2.4-1.8-3 .2-.9-2.9-2.5-1.7 1-2.8-1-2.8 2.5-1.7.9-2.9 3 .2z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'zap' -%}
      <path d="M13 2 4 14h7l-1 8 9-12h-7z"/>
    {%- when 'bulb' -%}
      <path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z"/>
    {%- when 'joint' -%}
      <path d="M17 10c.7-.7 1.7-.7 2.5 0a1.8 1.8 0 0 0 0-2.5 1.8 1.8 0 0 0-2.5-2.5 1.8 1.8 0 0 0-2.5 0c.7.8.7 1.8 0 2.5l-7 7c-.7.7-1.7.7-2.5 0a1.8 1.8 0 0 0 0 2.5 1.8 1.8 0 0 0 2.5 2.5 1.8 1.8 0 0 0 2.5 0c-.7-.8-.7-1.8 0-2.5z"/>
    {%- when 'sparkles' -%}
      <path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7-4.7-1.8 4.7-1.8z"/><path d="M19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>
    {%- when 'gut' -%}
      <path d="M9 3v4a5 5 0 0 0 5 5 4 4 0 0 1 4 4 5 5 0 0 1-5 5H9a4 4 0 0 1-4-4"/>
    {%- when 'moon' -%}
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'leaf' -%}
      <path d="M5 21c0-9 5-15 15-16-1 10-7 15-15 16z"/><path d="M5 21 14 12"/>
    {%- when 'dumbbell' -%}
      <path d="M6 7v10M18 7v10M3 9v6M21 9v6M6 12h12"/>
    {%- when 'refresh' -%}
      <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>
    {%- when 'cashback' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/>
    {%- when 'coin' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 6.5v11M15 9.5c0-1.1-1.3-2-3-2s-3 .9-3 2 1.3 1.7 3 2 3 .9 3 2-1.3 2-3 2-3-.9-3-2"/>
    {%- when 'waves' -%}
      <path d="M2 10c2.5-3 5-3 7.5 0s5 3 7.5 0 3.5-2 5 0"/><path d="M2 16c2.5-3 5-3 7.5 0s5 3 7.5 0 3.5-2 5 0"/>
    {%- when 'image' -%}
      <rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>
    {%- when 'capsule' -%}
      <rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="m9.5 9.5 5 5"/>
    {%- when 'capsule-h' -%}
      <rect x="3" y="8" width="18" height="8" rx="4"/><path d="M12 8v8"/>
    {%- when 'jar' -%}
      <path d="M7 3h10v3H7z"/><rect x="5" y="6" width="14" height="15" rx="2"/><path d="M5 11h14"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'calendar' -%}
      <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
    {%- when 'file-text' -%}
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6M9 9h2"/>
    {%- when 'list' -%}
      <path d="M9 6h11M9 12h11M9 18h11"/><path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01"/>
    {%- when 'alert-triangle' -%}
      <path d="M10.3 4.3 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/>
    {%- when 'help-circle' -%}
      <circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 0 1 4.8 1c0 1.7-2.3 2.2-2.3 3.5"/><path d="M12 17h.01"/>
    {%- when 'eye-off' -%}
      <path d="M3 3l18 18"/><path d="M10.6 5.1A10.7 10.7 0 0 1 12 5c5 0 9 4.5 10 7-.4 1-1.2 2.3-2.4 3.5"/><path d="M6.6 6.6C4.3 8 2.7 10.2 2 12c1 2.5 5 7 10 7 1.7 0 3.3-.5 4.6-1.3"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
    {%- when 'flame' -%}
      <path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2.2 1-3.6 2.2-4.8.3 1.7 1.2 2.6 2.3 2.8C11 8.5 11.3 5.6 12 3z"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>
    {%- when 'thumbs-up' -%}
      <path d="M7 11v9H4v-9z"/><path d="M7 11l4-7a2 2 0 0 1 3 2l-1 4h5.5a2 2 0 0 1 2 2.3l-1.2 6A2 2 0 0 1 17.3 20H7"/>
    {%- when 'message' -%}
      <path d="M4 5h16v11H9l-5 4z"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4z"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"/>
    {%- when 'trash' -%}
      <path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 13h10l1-13"/><path d="M9 7V4h6v3"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>
    {%- when 'youtube' -%}
      <rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/>
    {%- when 'facebook' -%}
      <path d="M15 3h-3a4 4 0 0 0-4 4v3H5v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.4 4.6 5 5"/>
  {%- endcase -%}
</svg>
