{%- comment -%}
  Área produto. Bloco "atributos" da seção main-product: carrossel de atributos (metafield
  beacon.atributos) com setas e pontos. Sem atributos, só mostra um aviso no editor. Extraído de
  sections/main-product.liquid (auditoria de arquitetura, 28/09/2026).
  Parâmetros:
  - product: o produto
  - block: o bloco "atributos" (ícones icon_1, icon_2...)
{%- endcomment -%}
{%- assign atributos = product.metafields.beacon.atributos.value -%}
{%- if atributos != blank -%}
  <div class="main-product__block attributes" role="group" aria-label="{{ 'produto.attributes.label' | t }}" {{ block.shopify_attributes }}>
    <carousel-slider class="attributes__carousel" data-mode="scroll">
      <div class="attributes__viewport">
        <ul class="attributes__track" role="list" data-carousel-track>
          {%- for atributo in atributos -%}
            {%- liquid
              assign attribute_icon_key = 'icon_' | append: forloop.index
              assign attribute_icon = block.settings[attribute_icon_key] | default: 'badge-check'
            -%}
            <li class="attributes__item" data-carousel-slide>
              <span class="attributes__icon" aria-hidden="true">{% render 'icon', name: attribute_icon, size: 40, stroke: '1.6' %}</span>
              <span class="attributes__text">{{ atributo | escape | replace: 'ao dia', 'ao&nbsp;dia' }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="attributes__nav">
        <button type="button" class="icon-button attributes__nav-button" aria-label="{{ 'produto.attributes.previous' | t }}" data-carousel-prev hidden>
          {%- render 'icon', name: 'chevron-left', size: 18 -%}
        </button>
        <span class="attributes__dots" aria-hidden="true" data-carousel-progress hidden></span>
        <button type="button" class="icon-button attributes__nav-button" aria-label="{{ 'produto.attributes.next' | t }}" data-carousel-next hidden>
          {%- render 'icon', name: 'chevron-right', size: 18 -%}
        </button>
      </div>
    </carousel-slider>
  </div>
{%- elsif request.design_mode -%}
  <p class="main-product__block main-product__editor-note" {{ block.shopify_attributes }}>{{ 'produto.editor.empty' | t: field: 'beacon.atributos' }}</p>
{%- endif -%}
