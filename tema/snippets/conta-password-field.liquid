{%- comment -%}
  Área conta: campo de senha com botão "Mostrar senha".
  Parâmetros:
  - id: id do campo (obrigatório e único na página)
  - name: atributo name (ex.: customer[password])
  - label: texto do rótulo (já traduzido)
  - autocomplete: 'current-password' ou 'new-password'
  - required: true para campo obrigatório (padrão false)
  - invalid: true quando o formulário voltou com erro neste campo (padrão false)
  - describedby: id do bloco de erros, ligado ao campo quando invalid (opcional)

  O botão nasce com hidden e só aparece quando o conta-password-field.js é carregado
  (sem JavaScript fica apenas o campo). É um botão de alternância: rótulo fixo e
  aria-pressed indicando se a senha está visível.
{%- endcomment -%}
<div class="field conta-field">
  <label class="field__label" for="{{ id }}">
    {{- label -}}
    {%- if required %} <span class="conta-required" aria-hidden="true">*</span>{% endif -%}
  </label>
  <conta-password-field class="conta-password">
    <input
      type="password"
      id="{{ id }}"
      name="{{ name }}"
      class="conta-password__input"
      autocomplete="{{ autocomplete }}"
      autocapitalize="off"
      spellcheck="false"
      {% if required %}required{% endif %}
      {% if invalid %}aria-invalid="true"{% if describedby != blank %} aria-describedby="{{ describedby }}"{% endif %}{% endif %}
    >
    <button
      type="button"
      class="conta-password__toggle"
      aria-controls="{{ id }}"
      aria-pressed="false"
      aria-label="{{ 'conta.general.show_password' | t }}"
      data-password-toggle
      hidden
    >
      <svg class="icon icon--eye conta-password__icon conta-password__icon--show" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12c1-2.5 5-7 10-7s9 4.5 10 7c-1 2.5-5 7-10 7S3 14.5 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
      {%- render 'icon', name: 'eye-off', size: 22, class: 'conta-password__icon conta-password__icon--hide' -%}
    </button>
  </conta-password-field>
</div>
