{%- comment -%}
  Metadados de compartilhamento (Open Graph e Twitter).
  Título, descrição e canonical ficam no layout.

  Parâmetros:
  - default_description: (opcional) descrição para quando page_description vem vazio. O layout
    principal só a preenche na página inicial (17/10/2026).

  Imagem (17/10/2026): vale page_image (a das Preferências da loja virtual, a do produto, a da
  coleção...). Só na página inicial e só sem page_image entra a imagem do ajuste "Imagem de
  compartilhamento" (settings.share_image, 1200 x 630 px). A meta twitter:image também só sai na
  página inicial. Nas outras páginas nada muda.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: default_description | default: shop.description | default: shop.name
  assign og_image = page_image
  if og_image == blank and request.page_type == 'index'
    assign og_image = settings.share_image
  endif

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url | escape }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type | escape }}">
<meta property="og:description" content="{{ og_description | strip_html | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' | escape }}">
{%- if og_image -%}
  {%- liquid
    assign og_image_width = og_image.width | at_most: 1200
    assign og_image_height = og_image.height | times: og_image_width | divided_by: og_image.width
    assign og_image_url = og_image | image_url: width: og_image_width
  -%}
  <meta property="og:image" content="http:{{ og_image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image_url }}">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape }}">
{%- if og_image and request.page_type == 'index' -%}
  <meta name="twitter:image" content="https:{{ og_image_url }}">
{%- endif -%}
